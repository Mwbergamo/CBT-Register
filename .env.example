APP_NAME="CodeBlue Register"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local development: sqlite is fine. In production (Bluehost) use mysql —
# see docs/BLUEHOST_DEPLOYMENT.md.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=register_checkout
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# "database" works everywhere Bluehost shared hosting does (no Redis
# required). The sync-queue retry job (ConnectWise outbox) runs on this
# queue — see docs/BLUEHOST_DEPLOYMENT.md for the cron-driven worker setup.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="register@codebluetechnology.com"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------
# ConnectWise Manage (on-premise) — see docs/CONNECTWISE_SETUP.md
# -----------------------------------------------------------------------
CONNECTWISE_SERVER=cw.codebluetechnology.com
CONNECTWISE_CODEBASE=
CONNECTWISE_COMPANY_ID=
CONNECTWISE_PUBLIC_KEY=
CONNECTWISE_PRIVATE_KEY=
CONNECTWISE_CLIENT_ID=
CONNECTWISE_TIMEOUT=8

CONNECTWISE_RETAIL_WAREHOUSE_ID=
CONNECTWISE_RETAIL_WAREHOUSE_NAME=Retail
CONNECTWISE_RETAIL_COMPANY_STATUS_ID=
CONNECTWISE_RETAIL_COMPANY_TYPE_ID=
CONNECTWISE_RETAIL_SITE_NAME="Retail Store"

CONNECTWISE_INVOICE_TYPE=Miscellaneous
CONNECTWISE_GL_BILLING_ACCOUNT_ID=

CONNECTWISE_CATALOG_CONDITIONS="inactiveFlag=false"
CONNECTWISE_CATALOG_PAGE_SIZE=200

# -----------------------------------------------------------------------
# Microsoft 365 / Entra ID SSO — see docs/AZURE_AD_SETUP.md
# -----------------------------------------------------------------------
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_REDIRECT_URI="${APP_URL}/auth/azure/callback"

# -----------------------------------------------------------------------
# Register settings
# -----------------------------------------------------------------------
REGISTER_TAX_RATE=0.0
